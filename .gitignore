# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.bin

# Build output
/bin/
/build/
/dist/
/tmp/

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov
*.prof
*.pprof

# Dependency directories
vendor/

# Go workspace file
go.work
go.work.sum

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/

# Logs & runtime data
*.log
logs/
tmp/
temp/
*.pid

# Local / machine-specific config overrides (keep etc/*.yaml tracked)
*-local.yaml
*-local.yml
*.local.yaml
*.local.yml

# OS
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~
.history/

# Docker local volumes / data
docker-data/
.data/

# Delve / debugger
__debug_bin*
