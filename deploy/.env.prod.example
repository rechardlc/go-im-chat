# 与日常 docker-compose.yml 共用 ./data 时，密码必须和「第一次初始化」时一致。
# 本仓库日常默认是 chat / 123456；真服务器首次部署请在空数据目录下改成强密码。
#
# 使用：
#   cp deploy/.env.prod.example deploy/.env.prod
#   make prod

POSTGRES_USER=chat
POSTGRES_PASSWORD=123456
POSTGRES_DB=chat

REDIS_PASSWORD=123456

JWT_SECRET=dev-secret-change-me

# 宿主机入口；本机 80 被占用时可改成 8080
NGINX_PORT=80
